# ============================================================
# JARVIS PC Agent — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'dadır; anahtarlar koda ASLA yazılmaz.
#
# NOT: Depo kökündeki .env dosyanız varsa (JARVIS_GROQ_API_KEY vb.)
# otomatik olarak okunur; bu dosya yalnızca agent'a özel değerler
# için gereklidir.
# ============================================================

# ── Sunucu ──────────────────────────────────────────────────
# Yerel makine dışından (telefon) erişmek için: 0.0.0.0
# GÜVENLİK: Faz 1'de kimlik doğrulama yoktur; localhost'ta kalın.
JARVIS_BIND=127.0.0.1
JARVIS_PORT=8000

# ── LLM sağlayıcısı ─────────────────────────────────────────
# Boş bırakılırsa otomatik algılanır (öncelik: groq → openai → anthropic → ollama → mock)
# Seçenekler: groq | openai | anthropic | ollama | mock
JARVIS_LLM_PROVIDER=

# Anahtarlar (sağlayıcıya göre doldurun):
JARVIS_GROQ_API_KEY=your_groq_api_key_here
JARVIS_OPENAI_API_KEY=your_openai_api_key_here
JARVIS_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modeller (boş → sağlayıcı varsayılanı)
JARVIS_GROQ_MODEL=openai/gpt-oss-20b
JARVIS_OPENAI_MODEL=gpt-4o-mini
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-20250514
JARVIS_LLM_MODEL=

# Yerel Ollama (isteğe bağlı): ör. http://localhost:11434
JARVIS_OLLAMA_URL=

# ── Hava durumu (OpenWeatherMap — ücretsiz anahtar) ──────────
# https://openweathermap.org/api
JARVIS_OWM_API_KEY=your_openweather_key_here
JARVIS_CITY=Tuzla,TR

# ── Arayüz varsayılanları ────────────────────────────────────
# Kullanılabilir: red | green | blue
JARVIS_DEFAULT_BG_COLOR=blue

# ── Test/kalibrasyon ────────────────────────────────────────
# 1 yapılırsa kamera tüm isteklerde devre dışı kalır (CI/sunucusuz ortam).
JARVIS_CAMERA_DISABLED=
