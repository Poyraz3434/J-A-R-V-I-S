# ============================================================
# JARVIS PC Agent — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'dadır; anahtarlar koda ASLA yazılmaz.
#
# NOT: Depo kökündeki .env dosyanız varsa (JARVIS_GROQ_API_KEY vb.)
# otomatik olarak okunur; bu dosya yalnızca agent'a özel değerler
# için gereklidir.
# ============================================================

# ── Sunucu ──────────────────────────────────────────────────
# Yerel makine dışından (telefon) erişmek için: 0.0.0.0
# Loopback dışı tüm bind adreslerinde cihaz eşleştirme otomatik zorunludur.
JARVIS_BIND=127.0.0.1
JARVIS_PORT=8000
JARVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LLM sağlayıcısı ─────────────────────────────────────────
# Boş bırakılırsa otomatik algılanır (öncelik: groq → openai → anthropic → ollama → mock)
# Seçenekler: groq | openai | anthropic | ollama | mock
JARVIS_LLM_PROVIDER=

# Anahtarlar (sağlayıcıya göre doldurun):
JARVIS_GROQ_API_KEY=your_groq_api_key_here
JARVIS_OPENAI_API_KEY=your_openai_api_key_here
JARVIS_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modeller (boş → sağlayıcı varsayılanı)
JARVIS_GROQ_MODEL=openai/gpt-oss-20b
JARVIS_OPENAI_MODEL=gpt-4o-mini
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-20250514
JARVIS_LLM_MODEL=

# Yerel Ollama (isteğe bağlı): ör. http://localhost:11434
JARVIS_OLLAMA_URL=

# ── Hava durumu (OpenWeatherMap — ücretsiz anahtar) ──────────
# https://openweathermap.org/api
JARVIS_OWM_API_KEY=your_openweather_key_here
JARVIS_CITY=Tuzla,TR

# ── Arayüz varsayılanları ────────────────────────────────────
# Kullanılabilir: red | green | blue
JARVIS_DEFAULT_BG_COLOR=blue

# ── Test/kalibrasyon ────────────────────────────────────────
# 1 yapılırsa kamera tüm isteklerde devre dışı kalır (CI/sunucusuz ortam).
JARVIS_CAMERA_DISABLED=

# --- Faz 5-6-7 entegrasyonlar (otomatik) ---
JARVIS_ALARM_IDLE_ACK_SECONDS=
JARVIS_FILES_DIR=
JARVIS_GROQ_BASE_URL=
JARVIS_HA_TOKEN=
JARVIS_HA_URL=
JARVIS_IMAP_HOST=
JARVIS_IMAP_PASSWORD=
JARVIS_IMAP_USER=
JARVIS_NEWS_FEEDS=
JARVIS_OPENAI_BASE_URL=
JARVIS_RELAY_HTTP_URL=
JARVIS_RELAY_TOKEN=
JARVIS_RELAY_URL=
JARVIS_VOICE_AUTOSTART=
JARVIS_VOICE_DISABLED=
JARVIS_WA_APIKEY=
JARVIS_WA_PHONE=
JARVIS_ALLOW_OUTBOUND_MESSAGES=0

# --- Faz 2 - Cihaz eslestirme ve guvenlik ---
# 1 ise loopback dışı isteklerde cihaz token'i ister (dış bind adreslerinde otomatik şart).
JARVIS_PAIRING_REQUIRED=

# --- Bolum B - Kimlik dogrulama (madde 5, 16) ---
# JWT imza anahtari. Guclu ve rastgele bir deger uretin, orn. PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Bos birakilirsa her baslangicta rastgele uretilir (token'lar restart'ta duser).
JARVIS_JWT_SECRET=

# --- Faz 2 - WoL node (LAN icinde her zaman acik cihaz) ---
# Orn. Raspberry Pi uzerindeki wol-node servisi
JARVIS_WOL_NODE_URL=
JARVIS_WOL_NODE_SECRET=
# PC'nin ag karti MAC adresi (uzaktan acma hedefi), orn. AA-BB-CC-DD-EE-FF
JARVIS_TARGET_MAC=
