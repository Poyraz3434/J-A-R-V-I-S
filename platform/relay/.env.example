# JARVIS Relay — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve doldurun. .env asla git'e commit edilmez!

# Agent ve telefonla paylaşılan gizli token (güçlü rastgele değer üretin:
#   python -c "import secrets; print(secrets.token_urlsafe(32))")
JARVIS_RELAY_TOKEN=

# Relay verilerinin saklanacağı dizin (varsayılan: ~/.jarvis-relay)
# JARVIS_RELAY_DATA=/var/lib/jarvis-relay

# WoL node (Raspberry Pi) ayarları — alarm için PC'yi uyandırmada kullanılır
# WoL node URL'si: relay'in erişebildiği Pi adresi (ör. http://192.168.1.50:8080)
JARVIS_WOL_NODE_URL=
JARVIS_WOL_NODE_SECRET=
# Hedef PC'nin ağ kartı MAC adresi (ipconfig /all ile öğrenilir)
JARVIS_TARGET_MAC=
