# ═══════════════════════════════════════════════════════════════════════════
# JARVIS v10 — Ortam Değişkenleri Şablonu
# ─────────────────────────────────────────────────────────────────────────
# Kullanım:
#   1. Bu dosyayı aynı klasöre ".env" adıyla KOPYALA (orijinalini sakla).
#   2. Değerleri kendi anahtarlarınla doldur.
#   3. ".env" dosyası .gitignore'dadır — ASLA commit edilmez, kimseyle paylaşma.
#
# Notlar:
#   - Sadece JARVIS_GROQ_API_KEY doldurulsa bile uygulama temel sohbetle çalışır;
#     diğer anahtarlar ilgili özellikleri (hava, e-posta, sunum...) etkinleştirir.
#   - JARVIS_ önekli değişkenler kısa adlara (ör. GROQ_API_KEY) göre ÖNCELİKLİDİR.
# ═══════════════════════════════════════════════════════════════════════════

# ── ZORUNLU: Ana AI sağlayıcısı (Groq) ─────────────────────────────────────
# console.groq.com → API Keys
JARVIS_GROQ_API_KEY=
# Varsayılan: openai/gpt-oss-20b
JARVIS_GROQ_MODEL=

# ── OPSİYONEL: İkincil AI sağlayıcısı (Gemini) ────────────────────────────
# aistudio.google.com → API anahtarı oluştur
JARVIS_GEMINI_API_KEY=
# Varsayılan: gemini-3.8-flash
JARVIS_GEMINI_MODEL=

# ── OPSİYONEL: Alternatif sağlayıcılar (model router) ─────────────────────
JARVIS_OPENAI_API_KEY=
JARVIS_ANTHROPIC_API_KEY=
# Yerel Ollama sunucusu (varsayılan: http://localhost:11434)
JARVIS_OLLAMA_URL=

# ── OPSİYONEL: Hava durumu (OpenWeatherMap) ───────────────────────────────
# openweathermap.org → API keys (ücretsiz katman yeterli)
JARVIS_OWM_API_KEY=
# Varsayılan konum — format: "Şehir,ÜlkeKodu" (ör. Tuzla,TR).
# Kod içinde varsayılan konum YOKTUR; boşsa hava durumu özelliği devre dışı kalır.
JARVIS_CITY=

# ── OPSİYONEL: E-posta gönderme (SMTP) ───────────────────────────────────
# Gmail kullanıyorsanız "Uygulama Şifresi" oluşturmanız gerekir:
# Google Hesabı → Güvenlik → 2 Adımlı Doğrulama → Uygulama Şifreleri
JARVIS_SMTP_USER=
JARVIS_SMTP_PASS=
# SMTP sunucu adresi ve portu (boşsa varsayılan: smtp.gmail.com / 465).
# Başka sağlayıcı kullanıyorsanız doldurun (ör. smtp.outlook.com / 587).
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=

# ── OPSİYONEL: WhatsApp (CallMeBot; alternatif olarak pywhatkit) ─────────
JARVIS_WA_PHONE=
JARVIS_WA_APIKEY=

# ── OPSİYONEL: Epson Connect yazdırma ─────────────────────────────────────
# Epson yazıcınızın "E-posta ile Yazdır" adresi (EpsonConnect panelinde görünür).
# Kod içinde varsayılan YOKTUR; boşsa yazdırma özelliği devre dışı kalır.
JARVIS_EPSON_EMAIL=

# ── OPSİYONEL: Otomatik sunum — Canva fallback (Özellik 1, adım 2) ────────
# Boşsa zincir otomatik olarak adım 3'e (PNG slayt görselleri) düşer.
CANVA_API_KEY=

# ── OPSİYONEL: Web otomasyonu için izinli ek alan adları ──────────────────
# Virgülle ayrılmış liste; örn. example.com,docs.example.com
# (Yerleşik güvenli liste dışına host eklemek için — dikkatli kullanın.)
JARVIS_WEB_AUTOMATION_HOSTS=

# ── OPSİYONEL: Güncelleme denetimi ────────────────────────────────────────
# GitHub "latest release" API adresi. Örnek:
# https://api.github.com/repos/KULLANICI/jarvis/releases/latest
# Boşsa otomatik denetim sessizce atlanır.
JARVIS_UPDATE_URL=
# Mevcut sürümü geçersiz kılmak için (boşsa config.py → APP_VERSION kullanılır;
# normal kurulumda BUNU AYARLAMAYIN).
JARVIS_VERSION=

# ── OPSİYONEL: Uzak bağlam paylaşımı ─────────────────────────────────────
# 1/true/yes/on → sohbet bağlamı uzak özelliklerle paylaşılır (gizlilikle
# ilgili; ne yaptığınızı bilmiyorsanız BOŞ BIRAKIN).
JARVIS_SHARE_CONTEXT=
